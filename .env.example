# 개발용 예시. 실제 운영에서는 반드시 새로 생성한 키를 쓸 것.
# development | production — production 에서는 개발용 키로 서버가 시작하지 않고,
# 로그인 화면의 계정 목록이 숨겨지며, 세션 쿠키가 HTTPS 전용이 된다.
IUM_ENV=development
# 세션 서명 키 (32자 이상). 생성: python -c "import secrets;print(secrets.token_urlsafe(48))"
IUM_SECRET_KEY=change-me-session-secret
# 식별정보 암호화 키 (Fernet). 생성: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
IUM_IDENTITY_KEY=
IUM_DATABASE_URL=sqlite:///./ium.db
# 매칭 승인 방식: member(위원 단독) | committee(협의체 공동결정)
IUM_MATCH_APPROVAL_MODE=committee
# committee 모드에서 필요한 승인 수
IUM_COMMITTEE_APPROVALS=2
